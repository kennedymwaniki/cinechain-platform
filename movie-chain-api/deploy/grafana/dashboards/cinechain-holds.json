  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "CineChain",
   "type": "dashboards",
   "tags": [
    "cinechain"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "tenant",
    "label": "chain",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "query_result(max by (slug, tenant) (cinechain_tenant_info{status!=\"deleted\"}))",
    "query": {
     "query": "query_result(max by (slug, tenant) (cinechain_tenant_info{status!=\"deleted\"}))",
     "refId": "tenant"
    },
    "regex": "/slug=\"(?<text>[^\"]+)\".*tenant=\"(?<value>[^\"]+)\"/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Holds placed",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum(((cinechain_hold_placed_total{tenant=~\"$tenant\"} - (cinechain_hold_placed_total{tenant=~\"$tenant\"} offset $__range or cinechain_hold_placed_total{tenant=~\"$tenant\"} * 0)) and resets(cinechain_hold_placed_total{tenant=~\"$tenant\"}[$__range]) == 0 or increase(cinechain_hold_placed_total{tenant=~\"$tenant\"}[$__range]) and resets(cinechain_hold_placed_total{tenant=~\"$tenant\"}[$__range]) > 0)) or vector(0))) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
