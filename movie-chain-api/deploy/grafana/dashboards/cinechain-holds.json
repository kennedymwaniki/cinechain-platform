   "title": "Redis ↔ Postgres divergence / min",
   "description": "Redis said free, Postgres said taken (or the reverse). Postgres wins.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "60 * sum(rate(cinechain_hold_redis_postgres_divergence_total[5m]))",
     "legendFormat": "divergences"
    }
   ],
