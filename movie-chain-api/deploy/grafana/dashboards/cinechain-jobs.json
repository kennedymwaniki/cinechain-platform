   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum(((cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"} - (cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"} offset $__range or cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"} * 0)) and resets(cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"}[$__range]) == 0 or increase(cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"}[$__range]) and resets(cinechain_notification_total{tenant=~\"$tenant\",outcome=\"sent\"}[$__range]) > 0)) or vector(0))) or vector(0)",
     "instant": true
    }
   ],
