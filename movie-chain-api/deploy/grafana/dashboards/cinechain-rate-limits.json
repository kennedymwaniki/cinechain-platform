  {
   "id": 1,
   "type": "stat",
   "title": "429s in range",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum(((cinechain_rate_limited_total{tenant=~\"$tenant\"} - (cinechain_rate_limited_total{tenant=~\"$tenant\"} offset $__range or cinechain_rate_limited_total{tenant=~\"$tenant\"} * 0)) and resets(cinechain_rate_limited_total{tenant=~\"$tenant\"}[$__range]) == 0 or increase(cinechain_rate_limited_total{tenant=~\"$tenant\"}[$__range]) and resets(cinechain_rate_limited_total{tenant=~\"$tenant\"}[$__range]) > 0)) or vector(0))) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 1000
       }
      ]
     },
     "mappings": [],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
