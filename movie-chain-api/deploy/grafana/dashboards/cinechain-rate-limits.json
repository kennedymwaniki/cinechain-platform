{
 "uid": "cinechain-rate-limits",
 "title": "CineChain — Rate limits & tiers",
 "description": "Noisy-neighbour control: per-tenant request rates against tier limits, 429s, and per-tenant latency.",
 "tags": [
  "cinechain",
  "operations"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "CineChain",
   "type": "dashboards",
   "tags": [
    "cinechain"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "tenant",
    "label": "chain",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "query_result(max by (slug, tenant) (cinechain_tenant_info{status!=\"deleted\"}))",
    "query": {
     "query": "query_result(max by (slug, tenant) (cinechain_tenant_info{status!=\"deleted\"}))",
     "refId": "tenant"
    },
    "regex": "/slug=\"(?<text>[^\"]+)\".*tenant=\"(?<value>[^\"]+)\"/",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
