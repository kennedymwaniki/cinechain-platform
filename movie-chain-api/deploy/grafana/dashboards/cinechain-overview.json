{
 "uid": "cinechain-overview",
 "title": "CineChain \u2014 overview",
 "tags": [
  "cinechain"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "tenant",
    "label": "tenant (metrics)",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(cinechain_http_request_duration_seconds_count, tenant)",
     "refId": "tenant"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "tenant_logs",
    "label": "tenant_id (logs)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Double sales (ever)",
   "description": "Should be impossible. Any value pages.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(cinechain_double_sale_total) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Redis",
   "description": "Down: holds run on Postgres alone.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(cinechain_redis_up)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Expired holds awaiting sweep",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(cinechain_seat_locks_past_expiry) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 100
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Onboarding stuck > 5 min",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(cinechain_onboarding_stuck_runs) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests / s by tenant",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tenant) (rate(cinechain_http_request_duration_seconds_count{tenant=~\"$tenant\"}[5m]))",
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "p95 latency by tenant (noisy-neighbour view)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (tenant, le) (rate(cinechain_http_request_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Hold acquire p95 by path",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (path, le) (rate(cinechain_hold_acquire_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
     "legendFormat": "{{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Holds placed / s by path (redis = fast path, postgres = fallback)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (path) (rate(cinechain_hold_placed_total{tenant=~\"$tenant\"}[5m]))",
     "legendFormat": "{{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Seats lost after capture (10 min, auto-refunded)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tenant) (increase(cinechain_booking_seats_lost_after_capture_total{tenant=~\"$tenant\"}[10m]))",
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Cross-tenant attempts: busiest actor per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (tenant) (cinechain_cross_tenant_attempts_max_per_actor{tenant=~\"$tenant\"})",
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Firing alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Logs (tenant_id from the tenancy context; contact details scrubbed)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=~\"cinechain-.*\"} | tenant_id=~\"$tenant_logs\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   }
  }
 ]
}