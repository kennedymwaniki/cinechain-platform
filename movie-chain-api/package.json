{
  "name": "movie-chain-api",
  "version": "0.1.0",
  "private": true,
  "description": "CineChain API — multi-tenant cinema ticketing",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "eslint \"src/**/*.ts\" && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:control": "node dist/main-control.js",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,mjs}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "keys:gen": "node scripts/gen-keys.mjs",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.isolation.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:reset": "tsx tools/db-reset.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx tools/db-seed.ts",
    "start:control:dev": "nest start --watch --entryFile main-control",
    "test:concurrency": "vitest run --config vitest.concurrency.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/websockets": "^12.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "msgpackr-extract",
      "@swc/core",
      "cpu-features",
      "ssh2",
      "protobufjs"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "@nestjs/core"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
