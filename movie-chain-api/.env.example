NODE_ENV=development
PORT=3000
CONTROL_PORT=3001
LOG_LEVEL=log
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000

# The application plane: cinechain_app is NOT the owner and is NOBYPASSRLS.
DATABASE_URL=postgres://cinechain_app:app-dev-password@localhost:5434/cinechain
DATABASE_POOL_MAX=20
# The identity plane (platform.*): refresh tokens, consumers, security events.
IDENTITY_DATABASE_URL=postgres://cinechain_identity:identity-dev-password@localhost:5434/cinechain
# The control plane process (pnpm start:control) — no grants on booking/ticket/payment.
CONTROL_DATABASE_URL=postgres://cinechain_control:control-dev-password@localhost:5434/cinechain
ONBOARDING_ATTEMPTS=3

REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cinechain
S3_SECRET_KEY=cinechain-minio-secret
S3_BUCKET=cinechain-media

JWT_KEYS_DIR=./keys
JWT_ISSUER=cinechain
JWT_ACCESS_TTL_STAFF=600
JWT_ACCESS_TTL_CONSUMER=900
JWT_ACCESS_TTL_CONTROL=600
JWT_REFRESH_TTL=2592000

# Google sign-in: set all three, or none (Google is then disabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- db:migrate / db:reset only (never read by the app) ---
DATABASE_ADMIN_URL=postgres://cinechain_admin:cinechain_admin@localhost:5434/cinechain
DB_APP_PASSWORD=app-dev-password
DB_IDENTITY_PASSWORD=identity-dev-password
DB_CONTROL_PASSWORD=control-dev-password
DB_SWEEPER_PASSWORD=sweeper-dev-password
